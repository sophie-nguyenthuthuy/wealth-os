# =============================================================================
# Wealth OS — environment variables
# Copy to .env and fill in. NEVER commit .env to source control.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# --- Database ---
DATABASE_URL=postgresql://wealthos:wealthos@localhost:5432/wealthos?schema=public
DATABASE_POOL_SIZE=10

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_TTL=2592000
BCRYPT_ROUNDS=12

# --- Remittance partner (sandbox) ---
REMITTANCE_PARTNER=sbi-remit
REMITTANCE_PARTNER_API_KEY=
REMITTANCE_PARTNER_BASE_URL=https://sandbox.sbiremit.example/v1

# --- FX provider ---
FX_PROVIDER=openexchangerates
FX_PROVIDER_API_KEY=
FX_REFRESH_INTERVAL_SECONDS=300
FX_SPREAD_BPS=50

# --- Notifications ---
FCM_SERVER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Rate limits ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
